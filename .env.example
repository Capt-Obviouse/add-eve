# Mail Configuration
# Copy this file to .env and fill in your actual values
SMTP_ADDRESS=smtp.sendgrid.net
SMTP_PORT=587
SMTP_AUTHENTICATION=plain
SMTP_USER_NAME=your_sendgrid_username
SMTP_PASSWORD=your_sendgrid_password
SMTP_DOMAIN=your_domain.com
SMTP_ENABLE_STARTTLS_AUTO=true

# Devise Configuration
DEVISE_MAILER_SENDER=your_app@yourdomain.com
DEVISE_SECRET_KEY=1234abc123

# Production Configuration
PRODUCTION_HOST=your-app.herokuapp.com